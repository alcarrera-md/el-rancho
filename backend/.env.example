# =========================================================
# El Rancho — plantilla de variables de entorno del backend
# Copia este archivo como .env y reemplaza los valores.
# NUNCA subas el archivo .env real al repositorio.
# =========================================================

# --- Servidor ---
PORT=3000
# development | production (en production solo se aceptan los orígenes de CORS_ORIGINS)
NODE_ENV=development

# --- Base de datos (PostgreSQL 13+) ---
DATABASE_URL=postgres://usuario:clave@localhost:5432/sistema_ganadero
# Solo para los comandos npm run migrate:*; nunca usa DATABASE_URL como respaldo.
MIGRATION_DATABASE_URL=postgres://usuario:clave@localhost:5432/sistema_ganadero

# --- Autenticación ---
# Genera uno propio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplaza_por_un_secreto_largo_y_aleatorio

# --- Seguridad HTTP ---
# Orígenes permitidos, separados por coma.
CORS_ORIGINS=http://localhost:5173
# Límite de intentos de inicio de sesión por ventana de tiempo.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# --- Integraciones opcionales (la app funciona sin ellas) ---
# Clima: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=
# Asistente con IA (Google Gemini). Sin clave, el asistente responde solo
# las consultas que resuelve con reglas locales.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=
GEMINI_TIMEOUT_MS=12000
# Envío del corte diario por correo (cuenta remitente + contraseña de aplicación).
EMAIL_REMITENTE=
EMAIL_APP_PASSWORD=
